---
import type { Category, Publisher } from '../types/game';

/** Props for the home-page filter form. */
interface Props {
    /** Categories offered as checkboxes. */
    categories: Category[];
    /** Publishers offered in the select. */
    publishers: Publisher[];
    /** Total number of games, used for the initial result count. */
    total: number;
}

const { categories, publishers, total } = Astro.props;
const focusRing = 'focus:ring-2 focus:ring-blue-500 focus:outline-none';
---

<form
    class="mb-8 bg-slate-800/60 border border-slate-700 rounded-xl p-6 shadow-lg"
    aria-label="Filter games"
    data-testid="game-filters"
    data-game-filters
>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <fieldset>
            <legend class="text-sm font-medium text-slate-200 mb-3">Categories</legend>
            <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                    <label class="inline-flex items-center gap-2 text-sm text-slate-300 bg-slate-900/50 border border-slate-700 rounded-lg px-3 py-1.5 cursor-pointer hover:bg-slate-700 transition-colors duration-200">
                        <input
                            type="checkbox"
                            name="category"
                            value={category.id}
                            class={`h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 ${focusRing}`}
                            data-testid={`filter-category-${category.id}`}
                        />
                        {category.name}
                    </label>
                ))}
            </div>
        </fieldset>

        <div>
            <label for="filter-publisher" class="block text-sm font-medium text-slate-200 mb-3">Publisher</label>
            <select
                id="filter-publisher"
                name="publisher"
                class={`w-full bg-slate-900 text-slate-100 border border-slate-600 rounded-lg px-3 py-2 text-sm ${focusRing}`}
                data-testid="filter-publisher"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                ))}
            </select>
        </div>
    </div>

    <div class="mt-6 flex items-center justify-between gap-4">
        <p class="text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-count">
            Showing {total} of {total} games
        </p>
        <button
            type="button"
            class={`text-sm font-medium text-blue-400 hover:text-blue-300 rounded-lg px-3 py-1.5 transition-colors duration-200 ${focusRing}`}
            data-testid="filter-clear"
        >
            Clear filters
        </button>
    </div>
</form>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-game-filters]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-filter-item]'));
    const count = document.querySelector<HTMLElement>('[data-testid="filter-count"]');
    const noMatch = document.querySelector<HTMLElement>('[data-testid="filter-no-match"]');
    const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');

    if (form && count) {
        const checkboxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
        const publisherSelect = form.querySelector<HTMLSelectElement>('select[name="publisher"]')!;
        const clearButton = form.querySelector<HTMLButtonElement>('[data-testid="filter-clear"]')!;

        /** Shows/hides cards for the current selection, updates the count, empty state and URL. */
        const apply = (): void => {
            const categoryIds = checkboxes.filter((c) => c.checked).map((c) => c.value);
            const publisherId = publisherSelect.value;
            let visible = 0;
            for (const card of cards) {
                const matches =
                    (categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '')) &&
                    (publisherId === '' || card.dataset.publisherId === publisherId);
                card.hidden = !matches;
                if (matches) visible++;
            }
            count.textContent = `Showing ${visible} of ${cards.length} games`;
            if (noMatch) noMatch.hidden = visible !== 0;
            if (grid) grid.hidden = visible === 0;

            const params = new URLSearchParams();
            categoryIds.forEach((id) => params.append('category', id));
            if (publisherId) params.set('publisher', publisherId);
            const query = params.toString();
            history.replaceState(null, '', query ? `?${query}` : location.pathname);
        };

        const initial = new URLSearchParams(location.search);
        const initialCategories = initial.getAll('category');
        checkboxes.forEach((c) => (c.checked = initialCategories.includes(c.value)));
        publisherSelect.value = initial.get('publisher') ?? '';
        if (publisherSelect.selectedIndex === -1) publisherSelect.value = '';

        form.addEventListener('change', apply);
        form.addEventListener('submit', (event) => event.preventDefault());
        clearButton.addEventListener('click', () => {
            checkboxes.forEach((c) => (c.checked = false));
            publisherSelect.value = '';
            apply();
        });
        apply();
    }
</script>
